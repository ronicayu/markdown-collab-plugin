    "@vscode/test-electron": "^3.1.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "prosemirror-markdown": "^1.13.4",
