{
  "name": "markdown-collab-plugin",
  "displayName": "Markdown Collab",
  "description": "Review Markdown with your AI agent — comments anchored in the file itself, suggestions you accept or reject. Works with Claude Code, Cursor, Windsurf, Codex and Copilot.",
  "version": "0.35.49",
  "icon": "media/icon.png",
  "publisher": "markdown-collab",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1E1B2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ronicayu/markdown-collab-plugin.git"
  },
  "homepage": "https://github.com/ronicayu/markdown-collab-plugin#readme",
  "bugs": {
    "url": "https://github.com/ronicayu/markdown-collab-plugin/issues"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "markdown",
    "review",
    "comments",
    "claude",
    "claude code",
    "ai",
    "agent",
    "mcp",
    "collaboration",
    "pull request",
    "code review",
    "wysiwyg",
    "gitlab",
    "technical writing",
    "docs",
    "cursor",
    "windsurf",
    "cascade",
    "codex",
    "copilot",
    "headless"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdownCollab.installClaudeSkill",
    "onCommand:markdownCollab.initializeAgents",
    "onCommand:markdownCollab.copyClaudePrompt",
    "onCommand:markdownCollab.sendAllToClaude",
    "onCommand:markdownCollab.startClaudeTerminal",
    "onCommand:markdownCollab.resetSendMode",
    "onView:markdownCollab.review",
    "onCommand:markdownCollab.openCollabEditor",
    "onCustomEditor:markdownCollab.collabEditor",
    "onCommand:markdownCollab.openInlineCommentsView",
    "onCommand:markdownCollab.askClaudeToReview",
    "onCommand:markdownCollab.askClaudeToReviewFolder",
    "onCommand:markdownCollab.nextUnreadFromClaude",
    "onCommand:markdownCollab.startPrReview",
    "onView:markdownCollab.prReviewFiles",
    "onCommand:markdownCollab.askClaudeToReviewChanges",
    "onCommand:markdownCollab.editReviewConventions",
    "onCommand:markdownCollab.reviewSummary",
    "onCommand:markdownCollab.openTutorial",
    "onCommand:markdownCollab.showOutput",
    "onCommand:markdownCollab.reportDiagnostics",
    "onCommand:markdownCollab.commentOnSelection",
    "onCommand:markdownCollab.removeResolvedComments"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode you can open the review view, read threads, add, reply to and resolve comments, and copy prompts to the clipboard. Sending to a terminal, running Claude, the review tool server, agent setup (AGENTS.md, .mcp.json, Claude Code plugin) and the Git and PR views are off until you trust the workspace.",
      "restrictedConfigurations": [
        "markdownCollab.sendMode",
        "markdownCollab.claudePath",
        "markdownCollab.headlessModel",
        "markdownCollab.plantuml.serverUrl",
        "markdownCollab.classicReviewView",
        "markdownCollab.collab.userName",
        "markdownCollab.plantuml.format"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownCollab.installClaudeSkill",
        "title": "Markdown Collab: Set Up Claude Code"
      },
      {
        "command": "markdownCollab.repairInlineComments",
        "title": "Markdown Collab: Repair Comment Anchors",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.initializeAgents",
        "title": "Markdown Collab: Initialize AGENTS.md"
      },
      {
        "command": "markdownCollab.copyClaudePrompt",
        "title": "Markdown Collab: Copy Prompt"
      },
      {
        "command": "markdownCollab.revealComment",
        "title": "Reveal Review Thread (tree)"
      },
      {
        "command": "markdownCollab.sendAllToClaude",
        "title": "Markdown Collab: Send Unresolved Comments to Agent"
      },
      {
        "command": "markdownCollab.startClaudeTerminal",
        "title": "Markdown Collab: Start Claude Review Terminal"
      },
      {
        "command": "markdownCollab.resetSendMode",
        "title": "Markdown Collab: Reset Send Mode"
      },
      {
        "command": "markdownCollab.openCollabEditor",
        "title": "Open in Markdown Collab (alias)",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.openInlineCommentsView",
        "title": "Open in Markdown Collab",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "markdownCollab.askClaudeToReview",
        "title": "Markdown Collab: Ask Agent to Review This Doc",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.askClaudeToReviewFolder",
        "title": "Markdown Collab: Ask Agent to Review These Docs",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.askClaudeToReviewChanges",
        "title": "Markdown Collab: Ask Agent to Review What Changed",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.nextUnreadFromClaude",
        "title": "Markdown Collab: Next Unread from Agent",
        "category": "Markdown Collab",
        "icon": "$(arrow-right)"
      },
      {
        "command": "markdownCollab.startPrReview",
        "title": "Markdown Collab: Open PR Review",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.reviewUncommittedChanges",
        "title": "Markdown Collab: Open Uncommitted Changes",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.uncommittedRefresh",
        "title": "Refresh Uncommitted Files",
        "category": "Markdown Collab",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownCollab.openUncommittedFile",
        "title": "Review uncommitted changes"
      },
      {
        "command": "markdownCollab.stageUncommittedFile",
        "title": "Stage File",
        "category": "Markdown Collab",
        "icon": "$(add)"
      },
      {
        "command": "markdownCollab.unstageUncommittedFile",
        "title": "Unstage File",
        "category": "Markdown Collab",
        "icon": "$(remove)"
      },
      {
        "command": "markdownCollab.prReviewAddComment",
        "title": "Add"
      },
      {
        "command": "markdownCollab.prReviewEditComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "markdownCollab.prReviewSaveEdit",
        "title": "Save"
      },
      {
        "command": "markdownCollab.prReviewCancelEdit",
        "title": "Cancel"
      },
      {
        "command": "markdownCollab.prReviewDeleteComment",
        "title": "Delete draft",
        "icon": "$(trash)"
      },
      {
        "command": "markdownCollab.openPrReviewFile",
        "title": "Open in PR review"
      },
      {
        "command": "markdownCollab.prReviewRefresh",
        "title": "Refresh Changed Files",
        "category": "Markdown Collab",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownCollab.toggleSuggestMode",
        "title": "Markdown Collab: Toggle Suggest Mode (propose edits as suggestions)",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.registerMcpServer",
        "title": "Markdown Collab: Register Review Tools with Claude Code (.mcp.json)",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.connectAgent",
        "title": "Markdown Collab: Connect an Agent…",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.disconnectAgent",
        "title": "Markdown Collab: Disconnect an Agent…",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.editReviewConventions",
        "title": "Markdown Collab: Edit Review Conventions",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.openTutorial",
        "title": "Markdown Collab: Open Tutorial Playground",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.reviewSummary",
        "title": "Markdown Collab: Review Session Summary",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.showOutput",
        "title": "Markdown Collab: Show Logs",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.reportDiagnostics",
        "title": "Markdown Collab: Report a Problem (collect diagnostics)",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.revealThread",
        "title": "Reveal Markdown Collab Thread"
      },
      {
        "command": "markdownCollab.resolveThread",
        "title": "Resolve Markdown Collab Thread"
      },
      {
        "command": "markdownCollab.replyToThread",
        "title": "Reply to Markdown Collab Thread"
      },
      {
        "command": "markdownCollab.commentOnSelection",
        "title": "Markdown Collab: Comment on Selection",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.removeResolvedComments",
        "title": "Markdown Collab: Remove All Resolved Comments",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.finalizeDocument",
        "title": "Markdown Collab: Remove All Review Data",
        "category": "Markdown Collab"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "title": "Key Handled by the Markdown Collab Editor"
      }
    ],
    "configuration": {
      "title": "Markdown Collab",
      "properties": {
        "markdownCollab.sendMode": {
          "type": "string",
          "enum": [
            "ask",
            "headless",
            "terminal",
            "clipboard"
          ],
          "enumDescriptions": [
            "Ask which way to send, the first time per workspace, then remember the answer. Run 'Markdown Collab: Reset Send Mode' to be asked again.",
            "Runs Claude for you in the background and shows progress in the status bar — if you'd rather not keep a terminal open; needs Claude Code installed and signed in.",
            "Type the prompt into your running terminal session. Works with any agent's terminal — recommended.",
            "Copy the prompt to your clipboard so you can paste it into your agent yourself."
          ],
          "default": "ask",
          "markdownDescription": "How the **Send** button gets your comments to your agent.\n\n- `ask` — asks the first time per workspace, then remembers your answer. Run [Reset Send Mode](command:markdownCollab.resetSendMode) to be asked again.\n- `terminal` — types the prompt into your running terminal session. Works with any agent's terminal — recommended.\n- `headless` — **Run Claude for me**: the extension runs Claude Code in the background and shows progress in the status bar. In this mode Claude can only read files and use the review tools — if you'd rather not keep a terminal open; needs Claude Code installed and signed in.\n- `clipboard` — copies the prompt so you can paste it into your agent yourself.\n\nWhichever agent you use, connect it to this extension's review tools so its edits arrive as edits you can undo — see **Connect an Agent…** in the README."
        },
        "markdownCollab.collab.userName": {
          "type": "string",
          "default": "",
          "description": "Display name attributed to your comments. Defaults to your OS username."
        },
        "markdownCollab.liveEditor.readOnly": {
          "type": "boolean",
          "default": true,
          "description": "Open the Markdown Collab view read-only. Switch to Editing in the toolbar above the document to turn editing on for that panel."
        },
        "markdownCollab.classicReviewView": {
          "type": "boolean",
          "default": false,
          "description": "Use the previous Markdown Collab view (rendered preview without editing). A later release removes this fallback."
        },
        "markdownCollab.plantuml.serverUrl": {
          "type": "string",
          "default": "https://www.plantuml.com/plantuml",
          "description": "PlantUML server used to render `plantuml`/`puml` fenced code blocks in the Markdown Collab view and the PR review preview. Defaults to the public instance. Point at a self-hosted server (e.g. http://localhost:8080) to keep your diagrams off the public web."
        },
        "markdownCollab.plantuml.format": {
          "type": "string",
          "enum": [
            "svg",
            "png"
          ],
          "default": "svg",
          "description": "Image format requested from the PlantUML server. SVG scales better; PNG is heavier but renders identically on every browser."
        },
        "markdownCollab.proposeEditsAsSuggestions": {
          "type": "boolean",
          "default": false,
          "description": "When on, Send asks the agent to propose its edits as suggestions (accept/reject) instead of applying them directly. Remembered per workspace."
        },
        "markdownCollab.showLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Show the source line number beside each block in the Markdown Collab view. Numbers are lines in the .md file itself, so frontmatter and the stored threads block are accounted for."
        },
        "markdownCollab.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `claude` executable, if it isn't on your PATH. Used by the **Run Claude for me** send mode. Leave empty to find it automatically (PATH, then the usual install locations)."
        },
        "markdownCollab.headlessModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for **Run Claude for me** runs — an alias like `sonnet` or `opus`, or a full model name. Leave empty to use Claude Code's default."
        }
      }
    },
    "keybindings": [
      {
        "command": "markdownCollab.openInlineCommentsView",
        "key": "ctrl+k ctrl+alt+v",
        "mac": "cmd+k cmd+alt+v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markdownCollab.commentOnSelection",
        "key": "ctrl+k ctrl+alt+m",
        "mac": "cmd+k cmd+alt+m",
        "when": "editorTextFocus && editorLangId == markdown && editorHasSelection"
      },
      {
        "command": "markdownCollab.nextUnreadFromClaude",
        "key": "ctrl+k ctrl+alt+n",
        "mac": "cmd+k cmd+alt+n",
        "when": "editorLangId == markdown || activeCustomEditorId == 'markdownCollab.collabEditor' || activeWebviewPanelId == 'markdownCollab.inlineCommentsView'"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "markdownCollab.liveEditorTyping"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "markdownCollab.liveEditorTyping"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+y",
        "when": "markdownCollab.liveEditorTyping && !isMac"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "markdownCollab.liveEditorTyping"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "markdownCollab.liveEditorTyping"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "markdownCollab.liveEditorTyping"
      },
      {
        "command": "markdownCollab.liveEditor.keyHandledInEditor",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "markdownCollab.liveEditorTyping"
      }
    ],
    "submenus": [
      {
        "id": "markdownCollab.explorerSubmenu",
        "label": "Markdown Collab"
      },
      {
        "id": "markdownCollab.editorSubmenu",
        "label": "Markdown Collab"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownCollab.revealComment",
          "when": "false"
        },
        {
          "command": "markdownCollab.openCollabEditor",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewAddComment",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewEditComment",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewSaveEdit",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewCancelEdit",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewDeleteComment",
          "when": "false"
        },
        {
          "command": "markdownCollab.openPrReviewFile",
          "when": "false"
        },
        {
          "command": "markdownCollab.openUncommittedFile",
          "when": "false"
        },
        {
          "command": "markdownCollab.revealThread",
          "when": "false"
        },
        {
          "command": "markdownCollab.stageUncommittedFile",
          "when": "false"
        },
        {
          "command": "markdownCollab.unstageUncommittedFile",
          "when": "false"
        },
        {
          "command": "markdownCollab.uncommittedRefresh",
          "when": "false"
        },
        {
          "command": "markdownCollab.prReviewRefresh",
          "when": "false"
        },
        {
          "command": "markdownCollab.askClaudeToReviewFolder",
          "when": "false"
        },
        {
          "command": "markdownCollab.registerMcpServer",
          "when": "false"
        },
        {
          "command": "markdownCollab.installClaudeSkill",
          "when": "false"
        },
        {
          "command": "markdownCollab.startClaudeTerminal",
          "when": "false"
        },
        {
          "command": "markdownCollab.copyClaudePrompt",
          "when": "false"
        },
        {
          "command": "markdownCollab.initializeAgents",
          "when": "false"
        },
        {
          "command": "markdownCollab.resolveThread",
          "when": "false"
        },
        {
          "command": "markdownCollab.replyToThread",
          "when": "false"
        },
        {
          "command": "markdownCollab.liveEditor.keyHandledInEditor",
          "when": "false"
        },
        {
          "command": "markdownCollab.connectAgent",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "markdownCollab.disconnectAgent",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "markdownCollab.startPrReview",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "markdownCollab.reviewUncommittedChanges",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "markdownCollab.openTutorial",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "markdownCollab.editReviewConventions",
          "when": "isWorkspaceTrusted"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markdownCollab.prReviewAddComment",
          "group": "inline",
          "when": "commentController == markdown-collab-pr && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markdownCollab.prReviewDeleteComment",
          "group": "inline@1",
          "when": "commentController == markdown-collab-pr && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "markdownCollab.prReviewEditComment",
          "group": "group@1",
          "when": "commentController == markdown-collab-pr && comment == prDraft"
        }
      ],
      "comments/comment/context": [
        {
          "command": "markdownCollab.prReviewSaveEdit",
          "group": "inline@1",
          "when": "commentController == markdown-collab-pr && comment == prDraft"
        },
        {
          "command": "markdownCollab.prReviewCancelEdit",
          "group": "inline@2",
          "when": "commentController == markdown-collab-pr && comment == prDraft"
        }
      ],
      "view/title": [
        {
          "command": "markdownCollab.prReviewRefresh",
          "when": "view == markdownCollab.prReviewFiles",
          "group": "navigation"
        },
        {
          "command": "markdownCollab.uncommittedRefresh",
          "when": "view == markdownCollab.uncommittedFiles",
          "group": "navigation"
        },
        {
          "command": "markdownCollab.nextUnreadFromClaude",
          "when": "view == markdownCollab.review",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownCollab.openInlineCommentsView",
          "when": "resourceExtname == .md",
          "group": "navigation@30"
        },
        {
          "submenu": "markdownCollab.explorerSubmenu",
          "when": "resourceExtname == .md || explorerResourceIsFolder",
          "group": "navigation@31"
        }
      ],
      "markdownCollab.explorerSubmenu": [
        {
          "command": "markdownCollab.askClaudeToReview",
          "when": "resourceExtname == .md",
          "group": "navigation@1"
        },
        {
          "command": "markdownCollab.askClaudeToReviewFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "markdownCollab.askClaudeToReviewChanges",
          "when": "resourceExtname == .md",
          "group": "navigation@3"
        },
        {
          "command": "markdownCollab.removeResolvedComments",
          "when": "resourceExtname == .md",
          "group": "navigation@4"
        },
        {
          "command": "markdownCollab.finalizeDocument",
          "when": "resourceExtname == .md",
          "group": "navigation@5"
        }
      ],
      "markdownCollab.editorSubmenu": [
        {
          "command": "markdownCollab.askClaudeToReview",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "markdownCollab.askClaudeToReviewChanges",
          "when": "resourceExtname == .md",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "markdownCollab.openInlineCommentsView",
          "when": "resourceLangId == markdown && activeCustomEditorId != 'markdownCollab.collabEditor'",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownCollab.openInlineCommentsView",
          "when": "resourceExtname == .md",
          "group": "1_open@1"
        },
        {
          "submenu": "markdownCollab.editorSubmenu",
          "when": "resourceExtname == .md",
          "group": "1_open@2"
        }
      ],
      "editor/context": [
        {
          "command": "markdownCollab.commentOnSelection",
          "when": "resourceLangId == markdown && editorHasSelection",
          "group": "navigation@29"
        },
        {
          "command": "markdownCollab.openInlineCommentsView",
          "when": "resourceLangId == markdown",
          "group": "navigation@30"
        },
        {
          "submenu": "markdownCollab.editorSubmenu",
          "when": "resourceLangId == markdown",
          "group": "navigation@31"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownCollab.stageUncommittedFile",
          "when": "view == markdownCollab.uncommittedFiles && viewItem =~ /uncommittedFile-(unstaged|partial)/",
          "group": "inline@1"
        },
        {
          "command": "markdownCollab.unstageUncommittedFile",
          "when": "view == markdownCollab.uncommittedFiles && viewItem =~ /uncommittedFile-(staged|partial)/",
          "group": "inline@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "markdownCollab.review",
          "name": "Comment Threads",
          "when": "markdownCollab.hasReview"
        },
        {
          "id": "markdownCollab.prReviewFiles",
          "name": "PR Review",
          "visibility": "collapsed",
          "when": "markdownCollab.workspaceHasGit && isWorkspaceTrusted"
        },
        {
          "id": "markdownCollab.uncommittedFiles",
          "name": "Uncommitted Markdown",
          "visibility": "collapsed",
          "when": "markdownCollab.workspaceHasGit && isWorkspaceTrusted"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "markdownCollab.collabEditor",
        "displayName": "Markdown Collab",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "walkthroughs": [
      {
        "id": "markdownCollab.gettingStarted",
        "title": "Review Markdown with an AI agent",
        "description": "Leave review comments anchored in the file itself, send them to your agent, and accept its suggestions — all without leaving your editor. Claude Code is the most complete setup; any other agent can act on the same file format, with the review tools as an optional upgrade.",
        "steps": [
          {
            "id": "playground",
            "when": "isWorkspaceTrusted",
            "title": "Try the loop in a playground",
            "description": "Open a scratch document that arrives mid-review — threads, a reply, and two pending suggestions. Click Accept, reply to a thread, resolve one. Nothing to configure.\n[Open the playground](command:markdownCollab.openTutorial)",
            "media": {
              "markdown": "media/walkthrough/playground.md"
            }
          },
          {
            "id": "connect-agent",
            "when": "isWorkspaceTrusted",
            "title": "Connect your agent",
            "description": "Pick your agent — Claude Code, Cursor, Windsurf, Codex, Copilot or another — and Markdown Collab sets up what it needs. No token is written to any file.\n[Connect an Agent…](command:markdownCollab.connectAgent)",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            },
            "completionEvents": [
              "onCommand:markdownCollab.connectAgent"
            ]
          },
          {
            "id": "comment",
            "title": "Comment on your own document",
            "description": "Open any .md file in Markdown Collab, select a passage, and write a note. The thread is stored in the file itself.\n[Open a document](command:markdownCollab.openInlineCommentsView)",
            "media": {
              "markdown": "media/walkthrough/comment.md"
            },
            "completionEvents": [
              "onCommand:markdownCollab.openInlineCommentsView"
            ]
          },
          {
            "id": "send",
            "title": "Send it to your agent",
            "description": "Click Send in the sidebar. The first time, pick how it's delivered; the terminal option works with any agent.\n[Send unresolved comments](command:markdownCollab.sendAllToClaude)",
            "media": {
              "markdown": "media/walkthrough/send.md"
            },
            "completionEvents": [
              "onCommand:markdownCollab.sendAllToClaude"
            ]
          },
          {
            "id": "ask-review",
            "title": "Or ask your agent to review",
            "description": "Flip the direction: your agent reads the doc and opens a thread per concern, for you to triage.\n[Ask Agent to Review](command:markdownCollab.askClaudeToReview)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onCommand:markdownCollab.askClaudeToReview"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "markdownCollab.mcpServerDefinitionProvider",
        "label": "Markdown Collab review tools"
      }
    ]
  },
  "scripts": {
    "compile": "npm run bundle:skill-cli && npm run build:plugin && tsc -p . && tsc -p tsconfig.webview.json && npm run bundle:extension && npm run bundle:webview && npm run bundle:inline-comments && npm run bundle:pr-review && npm run copy:shared-css && npm run copy:fixtures",
    "watch": "tsc -w -p .",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js --minify --sourcemap=linked --legal-comments=none",
    "bundle:webview": "esbuild src/webview/client.ts --bundle --format=iife --outfile=out/webview/client.js --target=es2020 --platform=browser --minify --sourcemap=linked --legal-comments=none",
    "bundle:webview:watch": "npm run bundle:webview -- --watch",
    "bundle:inline-comments": "esbuild src/inlineComments/webview/client.ts --bundle --format=iife --outfile=out/inlineComments/client.js --target=es2020 --platform=browser --minify --sourcemap=linked --legal-comments=none && node -e \"require('fs').copyFileSync('src/inlineComments/webview/client.css','out/inlineComments/client.css')\"",
    "bundle:pr-review": "esbuild src/pr/webview/client.ts --bundle --format=iife --outfile=out/pr/webview/client.js --target=es2020 --platform=browser --minify --sourcemap=linked --legal-comments=none",
    "copy:fixtures": "node -e \"const fs=require('fs'),p=require('path');function cp(s,d){fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s,{withFileTypes:true})){const ss=p.join(s,f.name),dd=p.join(d,f.name);if(f.isDirectory())cp(ss,dd);else fs.copyFileSync(ss,dd);}}cp('src/test/integration/fixtures','out/test/integration/fixtures')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "npm run compile && tsc -p tsconfig.e2e.json && playwright test",
    "test:webview:ui": "playwright test --ui",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "test:integration": "npm run clean && npm run compile && node ./out/test/integration/runTest.js",
    "bundle:skill-cli": "node scripts/build-skill-cli.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "copy:shared-css": "node scripts/copy-shared-css.mjs",
    "verify:keys": "node scripts/verify-webview-keybinding.mjs",
    "verify:editor-keys": "node scripts/verify-editor-keys.mjs",
    "record:gifs": "node scripts/record-gifs.mjs"
  },
